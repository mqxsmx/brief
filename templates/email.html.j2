<!DOCTYPE html>
<html lang="zh">
<head><meta charset="utf-8"><title>{{ digest.title }}</title></head>
<body style="font-family:-apple-system,'Segoe UI',sans-serif;color:#24292e;margin:20px">
  <h2 style="margin-bottom:4px">{{ digest.title }}</h2>
  <p style="color:#586069">{{ digest.date }} · 入选 {{ digest.projects|length }} 项</p>
  <table border="1" cellpadding="8" cellspacing="0"
         style="border-collapse:collapse;border-color:#e1e4e8;font-size:14px">
    <tr style="background:#f6f8fa">
      <th align="left">项目</th>
      <th>语言</th>
      <th>总⭐</th>
      <th>今日</th>
      <th align="left">简介</th>
    </tr>
    {% for p in digest.projects %}
    <tr>
      <td><a href="{{ p.url }}">{{ p.name }}</a></td>
      <td>{{ p.language }}</td>
      <td align="right">{{ p.stars_total }}</td>
      <td align="right">▲{{ p.stars_today }}</td>
      <td>
        {{ p.summary_cn or p.description }}
        {% if p.extra.get('inflate_flagged') %}
          <br><span style="color:#d73a49;font-size:12px">
            ⚠ 可疑:{{ p.extra.get('inflate_reasons', []) | join('; ') }}
          </span>
        {% endif %}
      </td>
    </tr>
    {% endfor %}
  </table>
  <p style="color:#586069;font-size:12px;margin-top:16px">由 Brief 自动生成</p>
</body>
</html>
