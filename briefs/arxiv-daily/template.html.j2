<!DOCTYPE html>
<html lang="zh">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ digest.title }}</title>
<style>
  @media (max-width: 600px) {
    .masthead { padding: 20px 16px 14px 16px !important; }
    .masthead-title { font-size: 22px !important; }
    .body-cell { padding: 14px 16px !important; }
    .card-title { font-size: 16px !important; }
    .footer-cell { padding: 12px 16px !important; }
  }
</style>
</head>
<body style="margin:0;padding:0;background:#f5f7fa;font-family:Georgia,'Times New Roman',serif;color:#1a202c">
  <table width="100%" cellpadding="0" cellspacing="0" style="background:#f5f7fa">
    <tr><td align="center" style="padding:24px 12px">
      <table cellpadding="0" cellspacing="0" style="width:100%;max-width:960px;background:#ffffff">
        <tr><td class="masthead" style="background:#1a365d;padding:28px 28px 20px 28px">
          <div style="font-size:12px;color:#a0aec0;letter-spacing:3px;font-weight:600">DAILY · 论文日报</div>
          <div class="masthead-title" style="font-size:28px;color:#ffffff;font-weight:700;margin-top:6px">{{ digest.title }}</div>
          <div style="font-size:13px;color:#cbd5e0;margin-top:6px;font-family:-apple-system,'Segoe UI',sans-serif">{{ digest.date }} · 本日精选 {{ digest.projects|length }} 篇</div>
        </td></tr>
        <tr><td class="body-cell" style="padding:18px 28px">
          {% for cat, items in digest.projects | groupby('category') %}
          <div style="margin-bottom:22px">
            <div style="font-size:15px;color:#1a365d;font-weight:700;border-bottom:2px solid #1a365d;padding-bottom:6px;margin-bottom:12px;font-family:-apple-system,'Segoe UI',sans-serif">{{ cat or '其他' }} · {{ items|length }} 篇</div>
            {% for p in items %}
            <div style="border-top:1px solid #e2e8f0;padding-top:12px;padding-bottom:8px;margin-bottom:14px">
              <a href="{{ p.url }}" class="card-title" style="font-size:17px;font-weight:700;color:#1a202c;text-decoration:none;line-height:1.3">{{ p.name }}</a>
              <div style="color:#718096;font-size:12px;margin-top:4px;font-family:-apple-system,'Segoe UI',sans-serif">{% if p.extra.authors %}{{ p.extra.authors[:3] | join(', ') }}{% if p.extra.authors|length > 3 %} 等{% endif %} · {% endif %}{% if p.extra.category %}{{ p.extra.category }} · {% endif %}{{ p.extra.published[:10] }}</div>
              <div style="font-size:15px;line-height:1.6;margin:8px 0">
                {% if p.summary_cn %}<strong>{{ p.summary_cn }}</strong>{% else %}{{ p.description[:300] }}{% endif %}
              </div>
              {% if p.editor_note %}
              <div style="font-size:13px;color:#4a5568;font-style:italic;margin:8px 0;border-left:3px solid #1a365d;padding-left:10px">{{ p.editor_note }}</div>
              {% endif %}
            </div>
            {% endfor %}
          </div>
          {% endfor %}
        </td></tr>
        <tr><td class="footer-cell" style="padding:16px 28px;border-top:1px solid #e2e8f0">
          <div style="font-size:12px;color:#718096;font-family:-apple-system,'Segoe UI',sans-serif">由 Brief 自动生成 · 数据来源 arXiv</div>
        </td></tr>
      </table>
    </td></tr>
  </table>
</body>
</html>
